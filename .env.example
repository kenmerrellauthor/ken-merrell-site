# ---- Admin login (required) ----
ADMIN_EMAIL=ken@example.com
ADMIN_PASSWORD=change-me-to-a-long-password
# Any long random string, used to sign the admin session cookie
SESSION_SECRET=replace-with-64-random-characters

# ---- Supabase (required on Vercel; without it the site uses local files in /data) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=media

# ---- Email delivery via Resend (form messages and signups go to the address set in Admin > Author & bio) ----
RESEND_API_KEY=
RESEND_FROM="Ken Merrell website <noreply@yourdomain.com>"

# ---- Cloudflare Turnstile spam protection ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Public URL of the site (used for SEO tags)
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com
